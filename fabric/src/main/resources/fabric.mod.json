{
  "schemaVersion": 1,
  "id": "piscosmetics",
  "version": "${version}",
  "name": "Pi's Cosmetics",
  "description": "Adds a framework for rendering animated cosmetics, with optional support for Accessories and Mega Showdown.",
  "authors": ["Pi-Eta"],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.pieta.piscosmetics.fabric.PisCosmeticsFabric"],
    "client": ["com.pieta.piscosmetics.fabric.PisCosmeticsFabricClient"]
  },
  "mixins": [
    "piscosmetics.mixins.json",
    "piscosmetics-fabric.mixins.json",
    "piscosmetics-accessories-fix.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "geckolib": ">=4.8.3"
  },
  "suggests": {
    "accessories": "*"
  },
  "breaks": {
    "accessories": "<1.1.0-beta.52"
  }
}
